\RequirePackage{caption}       % provides \captionof
% captions: smaller and muted so they don't compete with the body text; the label stays full strength
\DeclareCaptionFont{muted}{\color{ink!68!paper}}
\DeclareCaptionFont{inkc}{\color{ink}}
\captionsetup{font={small,muted}, labelfont={bf,inkc}, hypcap=false}   % hypcap off: \captionof is used outside floats
% \captionof sits in running text (not a float), so add a gap after it before the next paragraph
\AtBeginDocument{%   caption defines \captionof late, so wrap it here
  \NewCommandCopy\drp@captionof\captionof
  \RenewDocumentCommand\captionof{m o m}{%
    \IfNoValueTF{#2}{\drp@captionof{#1}{#3}}{\drp@captionof{#1}[#2]{#3}}%
    \par\addvspace{\medskipamount}}}
